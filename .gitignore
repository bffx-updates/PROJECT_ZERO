# ── Firmware ──────────────────────────────────────────────────────────
# Este repo hospeda apenas o webApp (publicado via GitHub Pages).
# Arquivos do firmware ficam locais — versionamento separado se um dia
# quiser. Os padroes abaixo cobrem so a raiz, sem afetar webApp/.
/*.h
/*.ino
/*.bat
/*.csv
/PROJECT_STRUCTURE.d
/CLAUDE.md
/data/

# ── Build / IDE ────────────────────────────────────────────────────────
*.o
*.obj
*.bin
*.elf
*.hex
*.map
build/
.build/
.vscode/
.idea/
*.swp
*.swo

# ── Sistema ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Python / webApp local server ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ── Sessão local de IA / settings de máquina ───────────────────────────
.claude/
*.local.json

# ── Lixo do projeto antigo / backups ───────────────────────────────────
Nova pasta/
webApp/backup-before-news-*/
webApp/uploads/
*.bak

# ── Credenciais persistidas no runtime (não devem entrar em git) ───────
data/wifi_sta.txt
# Certificado TLS + chave privada (gerados localmente, embutidos no firmware)
certs/

# ── Logs ───────────────────────────────────────────────────────────────
*.log
